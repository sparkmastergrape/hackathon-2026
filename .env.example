# Copy to .env and fill in. Never commit .env.

# Classic XRPL testnet seed (s...) — created by create-testnet-wallet.mjs
XRPL_SEED=""

# XRPL EVM Testnet key for the AGENT wallet (pays vouchers, needs XRP gas).
# Must match the agent wallet registered on AP4M My setup.
# Export from MetaMask: Account details -> Show private key.
AGENT_PRIVATE_KEY=""

# XRPL EVM Testnet key for the MERCHANT payout wallet (receives RLUSD).
# Must be a DIFFERENT wallet from the agent. Created by create-evm-wallet.mjs.
MERCHANT_PRIVATE_KEY=""

# Reference values from the AP4M portal (not secrets).
AP4M_AGENT_ADDRESS=""
AP4M_API_URL="https://hackathon.ap4m.build"

# Your registered team name, exactly as the AP4M portal shows it.
# The kit falls back to "Pending" if unset, which will fail sign-in for most teams.
TEAM_NAME=""

# RLUSD per payment, and the spending cap for a new channel.
PAYMENT_RLUSD="0.01"
CHANNEL_CAP="5"

# Optional. Leave CHANNEL_ID empty to open a new channel; set it to reuse an open one.
# PAYMENT_LEDGER and AP4M_RPC_URL default to the values from GET /public/config.
CHANNEL_ID=""
PAYMENT_LEDGER=""
AP4M_RPC_URL=""
