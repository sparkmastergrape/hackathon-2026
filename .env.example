# Copy to .env and fill in. Never commit .env.

# Classic XRPL testnet seed (s...) — created by create-testnet-wallet.mjs
XRPL_SEED=""

# XRPL EVM Testnet key for the AGENT wallet (pays vouchers, needs XRP gas).
# Must match the agent wallet registered on AP4M My setup.
# Export from MetaMask: Account details -> Show private key.
AGENT_PRIVATE_KEY=""

# XRPL EVM Testnet key for the MERCHANT payout wallet (receives RLUSD).
# Must be a DIFFERENT wallet from the agent. Created by create-evm-wallet.mjs.
MERCHANT_PRIVATE_KEY=""

# Reference values from the AP4M portal (not secrets).
AP4M_AGENT_ADDRESS=""
AP4M_API_URL="https://hackathon.ap4m.build"

# --- Mastercard Developers (sandbox) ---
# From a project at https://developer.mastercard.com/dashboard.
# Only needed for signed API calls; the MCP docs server needs no credentials.
MASTERCARD_CONSUMER_KEY=""
MASTERCARD_P12_PATH=""
MASTERCARD_P12_PASSWORD=""
MASTERCARD_KEY_ALIAS="keyalias"

# JWE payload encryption. Consent Management requires it on create-consents,
# start-authentication and verify-authentication. From the Developer Dashboard:
# "Client Encryption Keys" (request cert) and "Mastercard Encryption Keys".
MASTERCARD_ENCRYPTION_CERT_PATH=""
MASTERCARD_DECRYPTION_KEY_PATH=""

# Business Payment Controls: the funding source the agent's virtual cards draw
# on. Create one via POST /funding-sources, or look it up with a search.
BPC_FUNDING_SOURCE_GUID=""
